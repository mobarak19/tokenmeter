---
import ModelPicker from '../ModelPicker.astro';
import { defaultModels } from '../../lib/models';
import { SITE } from '../../data/site';
---
<div class="calc" data-calc="saas">
  <form>
    <h3 class="section-title" style="margin-top:0">Usage</h3>
    <div class="row3">
      <div class="field"><label for="users">Registered users</label><input class="input" id="users" name="users" type="number" min="1" step="100" value="10000" /></div>
      <div class="field"><label for="active">Daily active %</label><input class="input" id="active" name="active" type="number" min="0" max="100" step="1" value="30" /></div>
      <div class="field"><label for="msgs">Messages / active user / day</label><input class="input" id="msgs" name="msgs" type="number" min="0" step="1" value="5" /></div>
    </div>
    <ModelPicker value={defaultModels(['openai'])[0]} label="Model" max={1} />
    <div class="row3">
      <div class="field"><label for="in">Input tokens / message <span class="hint">incl. history</span></label><input class="input" id="in" name="in" type="number" min="0" step="50" value="500" /></div>
      <div class="field"><label for="out">Output tokens / message</label><input class="input" id="out" name="out" type="number" min="0" step="50" value="300" /></div>
      <div class="field"><label for="cache">Cached input %</label><input class="input" id="cache" name="cache" type="number" min="0" max="95" step="5" value="0" /></div>
    </div>
    <h3 class="section-title">Revenue & costs</h3>
    <div class="row3">
      <div class="field"><label for="price">Price / paying user / month</label><input class="input" id="price" name="price" type="number" min="0" step="0.5" value="9.99" /></div>
      <div class="field"><label for="paying">Paying users %</label><input class="input" id="paying" name="paying" type="number" min="0" max="100" step="0.5" value="5" /></div>
      <div class="field"><label for="margin">Target margin %</label><input class="input" id="margin" name="margin" type="number" min="0" max="95" step="5" value="70" /></div>
    </div>
    <div class="row2">
      <div class="field"><label for="fee">Payment / store fee</label><select class="select" id="fee" name="fee"><option value="2.9|0.3" selected>Card payments (2.9% + $0.30)</option><option value="15|0">App Store / Play, 15%</option><option value="30|0">App Store / Play, 30%</option><option value="5|0.5">Merchant of record (5% + $0.50)</option></select></div>
      <div class="field"><label for="infra">Server cost / user / month ($)</label><input class="input" id="infra" name="infra" type="number" min="0" step="0.01" value="0.05" /></div>
    </div>
    <div class="field"><label for="fixed">Fixed monthly costs ($) <span class="hint">tools, hosting, salaries</span></label><input class="input" id="fixed" name="fixed" type="number" min="0" step="100" value="500" /></div>
    <p class="note">Selling in an iOS app? See <a href={SITE.sister.url} target="_blank" rel="noopener">{SITE.sister.name}</a> for App Store fees with VAT.</p>
    <div class="share-row"><button type="button" class="btn btn-sm" data-action="copy-link">Copy link to this result</button><button type="button" class="btn btn-sm btn-ghost" data-action="reset">Reset</button></div>
  </form>
  <div class="out" data-out aria-live="polite"></div>
</div>
<script>
  import { mountCalc, num, esc } from '../../app/calc';
  import { mountPicker, byId } from '../../app/modelpicker';
  import { requestCost, money } from '../../lib/llm';
  import { saas } from '../../lib/saas';
  const root = document.querySelector<HTMLElement>('[data-calc="saas"]')!;
  mountCalc(root, (v) => {
    const m = byId.get((v.m ?? '').split(',')[0]);
    if (!m) return '<p class="muted">Choose a model.</p>';
    const perMsg = requestCost(m, { inTok: num(v.in), outTok: num(v.out), cachedPct: num(v.cache), batch: false }).perRequest;
    const [feePct, feeFixed] = (v.fee ?? '2.9|0.3').split('|').map(Number);
    const base = { activePct: num(v.active), msgs: num(v.msgs), aiPerMsg: perMsg, payingPct: num(v.paying), price: num(v.price), feePct, feeFixed, infraPerUser: num(v.infra), fixed: num(v.fixed), targetMargin: num(v.margin) };
    const r = saas({ ...base, users: num(v.users) });
    const good = r.profit >= 0;
    const proj = [100, 1000, 10000, 100000, 1000000].map((n) => ({ n, x: saas({ ...base, users: n }) }));
    return `<div class="big"><div class="k">Monthly profit</div><div class="v" style="color:var(${good ? '--ok' : '--high'})">${money(r.profit)}</div>
        <div class="s">Revenue ${money(r.revenue)} · margin ${Number.isFinite(r.margin) ? Math.round(r.margin * 100) + '%' : '–'} · ${Math.round(r.paying).toLocaleString()} paying users</div></div>
      <table class="kv">
        <tr><th>AI cost per message (${esc(m.name)})</th><td>${money(perMsg)}</td></tr>
        <tr><th>AI cost per user / month</th><td>${money(r.aiPerUser)}</td></tr>
        <tr><th>AI cost per paying user</th><td>${money(r.aiPerPaying)}</td></tr>
        <tr><th>Total AI cost / month</th><td>${money(r.aiTotal)}</td></tr>
        <tr><th>Payment fees / month</th><td>${money(r.fees)}</td></tr>
        <tr><th>Break-even</th><td>${Number.isFinite(r.breakEvenUsers) ? r.breakEvenUsers.toLocaleString() + ' users' : 'never at this price'}</td></tr>
        <tr><th><strong>Minimum price for ${num(v.margin)}% margin</strong></th><td><strong>${Number.isFinite(r.minPrice) ? money(r.minPrice) : 'not reachable'}</strong></td></tr>
      </table>
      <div class="table-wrap"><table class="data-table"><thead><tr><th class="r"><button disabled>Users</button></th><th class="r"><button disabled>Revenue</button></th><th class="r"><button disabled>AI cost</button></th><th class="r"><button disabled>Profit</button></th></tr></thead><tbody>
        ${proj.map(({ n, x }) => `<tr><td class="r">${n.toLocaleString()}</td><td class="r">${money(x.revenue)}</td><td class="r">${money(x.aiTotal)}</td><td class="r" style="color:var(${x.profit >= 0 ? '--ok' : '--high'})">${money(x.profit)}</td></tr>`).join('')}
      </tbody></table></div>`;
  });
  mountPicker(root.querySelector<HTMLElement>('[data-picker]')!, 1);
</script>
