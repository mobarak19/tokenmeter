---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import { SECTIONS, toolsIn, type Section } from '../data/tools';
import { u } from '../lib/url';
const path = Astro.url.pathname;
const order: Section[] = ['cost', 'tokens', 'hardware', 'saas', 'data'];
---
<header class="site-header">
  <div class="container">
    <a class="logo" href={u('/')} aria-label={`${SITE.name} home`}>
      <span class="logo-mark"><Icon name="gauge" size={20} /></span>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Main">
      <details class="nav-tools" data-nav-tools>
        <summary class="nav-keep">Calculators <Icon name="chevronDown" size={16} /></summary>
        <div class="nav-menu">
          {order.flatMap((s) => toolsIn(s)).map((t) => (
            <a href={u(`/${t.slug}/`)} aria-current={path.startsWith(u(`/${t.slug}/`)) ? 'page' : undefined}>
              <Icon name={t.icon} size={20} />
              <span><strong>{t.name}</strong><span>{t.card}</span></span>
            </a>
          ))}
        </div>
      </details>
      <a href={u('/llm-pricing/')} aria-current={path.startsWith(u('/llm-pricing/')) ? 'page' : undefined}>Pricing</a>
      <a href={u('/vram/')} aria-current={path.startsWith(u('/vram/')) ? 'page' : undefined}>VRAM</a>
      <a href={u('/guides/')} aria-current={path.startsWith(u('/guides/')) ? 'page' : undefined}>Guides</a>
    </nav>
  </div>
</header>
