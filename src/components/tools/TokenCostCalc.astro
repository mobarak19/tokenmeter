---
import ModelPicker from '../ModelPicker.astro';
import { defaultModels, MODELS, flagship } from '../../lib/models';
import { perMillion } from '../../lib/llm';
import { u } from '../../lib/url';
const table = ['openai', 'anthropic', 'google', 'deepseek', 'mistralai', 'x-ai', 'qwen', 'meta-llama'].map(flagship).filter(Boolean);
---
<div class="calc" data-calc="tokcost">
  <form>
    <div class="row2">
      <div class="field"><label for="tin">Input tokens</label><input class="input" id="tin" name="tin" type="number" min="0" step="1000" value="1000000" /></div>
      <div class="field"><label for="tout">Output tokens</label><input class="input" id="tout" name="tout" type="number" min="0" step="1000" value="1000000" /></div>
    </div>
    <div class="field"><span class="label">Prices from</span>
      <div class="seg" role="radiogroup" aria-label="Price source"><label><input type="radio" name="src" value="model" checked /><span>A model</span></label><label><input type="radio" name="src" value="custom" /><span>Custom prices</span></label></div>
    </div>
    <div data-model-field><ModelPicker value={defaultModels(['openai'])[0] ?? MODELS[0].id} label="Model" max={1} /></div>
    <div class="row2" data-custom-field>
      <div class="field"><label for="pi">Input $ / 1M tokens</label><input class="input" id="pi" name="pi" type="number" min="0" step="0.01" value="1" /></div>
      <div class="field"><label for="po">Output $ / 1M tokens</label><input class="input" id="po" name="po" type="number" min="0" step="0.01" value="4" /></div>
    </div>
    <div class="share-row"><button type="button" class="btn btn-sm" data-action="copy-link">Copy link to this result</button><button type="button" class="btn btn-sm btn-ghost" data-action="reset">Reset</button></div>
    <h3 class="section-title">Cost of 1 million tokens: latest flagship models</h3>
    <div class="table-wrap"><table class="data-table"><thead><tr><th><button disabled>Model</button></th><th class="r"><button disabled>1M input</button></th><th class="r"><button disabled>1M output</button></th></tr></thead>
      <tbody>{table.map((m) => <tr><td><a href={u(`/models/${m!.slug}/`)}>{m!.name}</a></td><td class="r">{perMillion(m!.input)}</td><td class="r">{perMillion(m!.output)}</td></tr>)}</tbody></table></div>
  </form>
  <div class="out" data-out aria-live="polite"></div>
</div>
<script>
  import { mountCalc, num, esc } from '../../app/calc';
  import { mountPicker, byId } from '../../app/modelpicker';
  import { money } from '../../lib/llm';
  const root = document.querySelector<HTMLElement>('[data-calc="tokcost"]')!;
  mountCalc(root, (v) => {
    const custom = v.src === 'custom';
    root.querySelector<HTMLElement>('[data-model-field]')!.hidden = custom;
    root.querySelector<HTMLElement>('[data-custom-field]')!.hidden = !custom;
    const m = byId.get((v.m ?? '').split(',')[0]);
    const pi = custom ? num(v.pi) : m?.i ?? 0, po = custom ? num(v.po) : m?.o ?? 0;
    const ci = (num(v.tin) / 1e6) * pi, co = (num(v.tout) / 1e6) * po;
    return `<div class="big"><div class="k">Total cost</div><div class="v">${money(ci + co)}</div><div class="s">${custom ? 'Custom prices' : esc(m?.name ?? '')} · $${+pi.toFixed(4)} in / $${+po.toFixed(4)} out per 1M</div></div>
      <table class="kv"><tr><th>Input (${num(v.tin).toLocaleString()} tokens)</th><td>${money(ci)}</td></tr><tr><th>Output (${num(v.tout).toLocaleString()} tokens)</th><td>${money(co)}</td></tr>
      <tr><th>Blended $ per 1M tokens</th><td>${money((num(v.tin) + num(v.tout)) ? ((ci + co) / (num(v.tin) + num(v.tout))) * 1e6 : 0)}</td></tr></table>`;
  });
  mountPicker(root.querySelector<HTMLElement>('[data-picker]')!, 1);
</script>
