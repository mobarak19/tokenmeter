---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import ToolGrid from './ToolGrid.astro';
import { SITE } from '../data/site';
import { SECTIONS, TOOLS, type Tool } from '../data/tools';
import { offersHtml } from '../lib/offers';
import { u } from '../lib/url';
import data from '../data/generated/models.json';

interface Props { tool: Tool; wide?: boolean }
const { tool, wide = false } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const pageUrl = new URL(u(`/${tool.slug}/`), site).href;
const section = SECTIONS[tool.section];
const sectionUrl = u(`/#${tool.section}`);
const related = tool.related.map((s) => TOOLS.find((t) => t.slug === s)!).filter(Boolean);
const updated = new Date(data.updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication', name: tool.name, url: pageUrl, description: tool.description,
    applicationCategory: 'DeveloperApplication', operatingSystem: 'Any (web browser)', isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(u('/'), site).href },
      { '@type': 'ListItem', position: 2, name: section.name, item: new URL(sectionUrl, site).href },
      { '@type': 'ListItem', position: 3, name: tool.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: tool.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base title={tool.title} description={tool.description} jsonLd={jsonLd}>
  <section class="hero container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={u('/')}>Home</a> / <a href={sectionUrl}>{section.name}</a> / <span aria-current="page">{tool.name}</span></nav>
    <span class="eyebrow"><Icon name={tool.icon} size={15} /> {tool.name}</span>
    <h1>{tool.h1}</h1>
    <p class="lead">{tool.lead}</p>
    <div class="trust-row">
      <span><Icon name="history" size={16} /> Prices updated {updated}</span>
      <span><Icon name="lock" size={16} /> Runs in your browser</span>
      <span><Icon name="link" size={16} /> Shareable results</span>
    </div>
  </section>

  <section class={`container ${wide ? '' : ''}`} id="tool">
    <div class="card card-pad">
      <slot />
    </div>
    {tool.placement && <Fragment set:html={offersHtml(tool.placement, { title: 'Useful for this' })} />}
  </section>

  {tool.sections.length > 0 && (
    <section class="section container">
      <div class="two-col">
        <article class="prose">
          {tool.sections.map((s) => (<Fragment><h2>{s.h2}</h2><Fragment set:html={s.html} /></Fragment>))}
        </article>
        <aside class="aside-card" aria-label="About these tools">
          <h3 style="display:flex;gap:8px;align-items:center"><Icon name={section.icon} size={20} /> {section.name}</h3>
          <p class="small" style="color:var(--text-2)">{section.text}</p>
          <ul class="small">{TOOLS.filter((t) => t.section === tool.section && t.slug !== tool.slug).map((t) => <li><a href={u(`/${t.slug}/`)}>{t.name}</a></li>)}</ul>
          <Fragment set:html={offersHtml('sidebar', { compact: true })} />
        </aside>
      </div>
    </section>
  )}

  <slot name="after" />

  <Faq items={tool.faq} />

  <section class="section container" aria-labelledby="related">
    <div class="section-head"><h2 id="related">Related tools</h2></div>
    <ToolGrid tools={related} />
  </section>
</Base>
