---
interface Props { kind: 'image' | 'video' }
const { kind } = Astro.props;
---
<div class="calc" data-calc="media" data-kind={kind}>
  <form>
    {kind === 'image' ? (
      <div class="row3">
        <div class="field"><label for="per">Images per request</label><input class="input" id="per" name="per" type="number" min="1" step="1" value="4" /></div>
        <div class="field"><label for="rpd">Requests / day</label><input class="input" id="rpd" name="rpd" type="number" min="0" step="10" value="500" /></div>
        <div class="field"><label for="price">$ per image</label><input class="input" id="price" name="price" type="number" min="0" step="0.001" value="0.04" /></div>
      </div>
    ) : (
      <div class="row3">
        <div class="field"><label for="sec">Seconds per video</label><input class="input" id="sec" name="sec" type="number" min="1" step="1" value="10" /></div>
        <div class="field"><label for="rpd">Videos / day</label><input class="input" id="rpd" name="rpd" type="number" min="0" step="1" value="20" /></div>
        <div class="field"><label for="price">$ per second</label><input class="input" id="price" name="price" type="number" min="0" step="0.01" value="0.10" /></div>
      </div>
    )}
    <div class="row2">
      <div class="field"><label for="retry">Retry / regeneration rate %</label><input class="input" id="retry" name="retry" type="number" min="0" max="500" step="5" value="20" /></div>
      <div class="field"><label for="users">Active users <span class="hint">for per-user cost</span></label><input class="input" id="users" name="users" type="number" min="1" step="10" value="200" /></div>
    </div>
    <p class="note">Enter the current price for your model, size and quality from the provider’s pricing page.</p>
    <div class="share-row"><button type="button" class="btn btn-sm" data-action="copy-link">Copy link to this result</button><button type="button" class="btn btn-sm btn-ghost" data-action="reset">Reset</button></div>
  </form>
  <div class="out" data-out aria-live="polite"></div>
</div>
<script>
  import { mountCalc, num } from '../../app/calc';
  import { money } from '../../lib/llm';
  const root = document.querySelector<HTMLElement>('[data-calc="media"]')!;
  const video = root.dataset.kind === 'video';
  mountCalc(root, (v) => {
    const retry = 1 + num(v.retry) / 100;
    const unitsPerDay = (video ? num(v.rpd) : num(v.rpd) * num(v.per)) * retry; // videos or images generated
    const perUnit = video ? num(v.sec) * num(v.price) : num(v.price);
    const daily = unitsPerDay * perUnit;
    const rows = video
      ? [['Cost per video', perUnit], ['Cost per minute of video', num(v.price) * 60], ['Per 1,000 videos', perUnit * 1000]]
      : [['Per 1,000 images', perUnit * 1000], ['Images generated / month', unitsPerDay * 30]];
    return `<div class="big"><div class="k">Monthly cost</div><div class="v">${money(daily * 30)}</div><div class="s">${money(daily)} per day · ${money(daily * 365)} per year · ${money((daily * 30) / Math.max(1, num(v.users)))} per user</div></div>
      <table class="kv">${rows.map(([k, x]) => `<tr><th>${k}</th><td>${k.toString().startsWith('Images generated') ? Math.round(x as number).toLocaleString() : money(x as number)}</td></tr>`).join('')}
      <tr><th>Includes retries</th><td>×${retry.toFixed(2)}</td></tr></table>`;
  });
</script>
