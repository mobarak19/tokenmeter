---
import Base from '../layouts/Base.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { TOOLS } from '../data/tools';
---
<Base title="Page not found" description="The page you were looking for doesn't exist.">
  <section class="hero container">
    <h1>Page not found</h1>
    <p class="lead">The page you were looking for doesn’t exist. Try one of these tools instead.</p>
  </section>
  <div class="container"><ToolGrid tools={TOOLS} /></div>
</Base>
