---
import Icon from './Icon.astro';
interface Props { items: [string, string][]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
<section class="section container" aria-labelledby="faq-title">
  <div class="section-head"><h2 id="faq-title">{title}</h2></div>
  <div class="faq">
    {items.map(([q, a], i) => (
      <details open={i === 0}>
        <summary>{q}<Icon name="chevronDown" size={18} /></summary>
        <div class="answer"><p set:html={a} /></div>
      </details>
    ))}
  </div>
</section>
