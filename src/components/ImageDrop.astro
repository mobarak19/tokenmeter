---
import Icon from './Icon.astro';
---
<label class="dropzone" style="min-height:84px;padding:14px" data-imgdrop>
  <input type="file" accept="image/*" class="visually-hidden" />
  <span class="small"><Icon name="upload" size={18} /> <span data-drop-name>Or drop a photo to read its size (stays on your device)</span></span>
</label>
